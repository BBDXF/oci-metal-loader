#!/bin/sh
# omloader stage 1 (PID 1 in the tiny initramfs): find the live medium, loop-mount the squashfs layers,
# overlay them with a tmpfs upper and switch_root into the Debian live system (systemd).
export PATH=/usr/bin:/bin:/sbin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /dev/pts /run /newroot
mount -t tmpfs -o mode=755 tmpfs /run
mount -t devpts devpts /dev/pts 2>/dev/null
echo 1 > /proc/sys/kernel/sysrq
CMD=$(cat /proc/cmdline)
arg() { for a in $CMD; do case "$a" in "$1="*) echo "${a#*=}"; return;; esac; done; }
echo "OMLOADER_STAGE1: starting (kernel $(uname -r))"

for m in $(cat /etc/modules-list); do modprobe "$m" 2>/dev/null; done

die() { echo "OMLOADER_STAGE1: FATAL: $*"; echo "dropping to a rescue shell (poweroff -f to stop)"; exec setsid sh -c 'exec sh </dev/console >/dev/console 2>&1'; }

mkdir -p /run/medium /run/live /run/extra /run/rw
has_live() { [ -f /run/medium/live/live.squashfs ] && [ -f /run/medium/live/omloader.squashfs ]; }
try_dev() { # $1 = block device. Typed mount only: an untyped `mount` probes every filesystem driver on every disk/partition, which floods the
  # console with exFAT-fs "failed to read boot sector" errors on machines with other disks (and is slow, on every retry).
  local t; t=$(blkid -o value -s TYPE "$1" 2>/dev/null)
  case "$t" in iso9660|udf|vfat|ext2|ext3|ext4) ;; *) return 1;; esac
  mount -t "$t" -o ro "$1" /run/medium 2>/dev/null || return 1
  has_live && return 0
  umount /run/medium 2>/dev/null; return 1
}
FOUND=; HOW=
# ---- (c) iso-scan: the ISO is a *file* on some partition (Ventoy, a plain data stick, ...) ----
# Order: omloader.isofile=/path.iso pin > Ventoy-looking partitions first > ventoy.json VTOY_DEFAULT_SEARCH_ROOT/IMAGE > omloader/ dir > scan.
# omloader.isofile=/path.iso [omloader.isodev=LABEL=x|UUID=x|/dev/x] pins it; else /omloader.iso, /omloader/omloader.iso,
# /ISO/omloader.iso (+ /omloader/omloader-<ver>.iso), then every *.iso within two directory levels whose volume label is OMLOADER_LIVE.
HOST=/run/medium-host; mkdir -p $HOST /run/omloader
ISOFILE=$(arg omloader.isofile); ISODEV=$(arg omloader.isodev); SCANNED=" "; ISOLOOP=; ISOPATH=
iso_try() { # $1 = ISO file, $2 = 1 -> no volume label check (explicit name)
  [ -f "$1" ] || return 1
  lo=$(losetup -f 2>/dev/null) && losetup -r "$lo" "$1" 2>/run/losetup.err || { echo "OMLOADER_STAGE1: losetup $1: $(cat /run/losetup.err)"; return 1; }
  if [ -z "$2" ] && [ "$(blkid -o value -s LABEL "$lo" 2>/dev/null)" != OMLOADER_LIVE ]; then losetup -d "$lo" 2>/dev/null; return 1; fi
  if mount -t iso9660 -o ro "$lo" /run/medium 2>/dev/null && has_live; then ISOLOOP=$lo; return 0; fi
  umount /run/medium 2>/dev/null; losetup -d "$lo" 2>/dev/null; return 1
}
resolve_dev() { case "$1" in LABEL=*) blkid -L "${1#LABEL=}";; UUID=*) blkid -U "${1#UUID=}";; *) echo "$1";; esac 2>/dev/null; }
# NTFS: the in-kernel ntfs3 (6.12; ntfs3.ko is in the stage-1 module list) is the default: real fallocate, no FUSE daemon. ntfs-3g (FUSE,
# installed as "@ntfs-3g": the '@' argv[0] convention makes systemd leave the daemon alone at switch-root / shutdown) is the FALLBACK
# when ntfs3 cannot mount (module missing, volume refused). NTFSDRV records which driver holds $HOST (-> medium.env MEDIUM_HOST_DRV).
NTFSDRV=
ntfs_mnt() { # $1 = ro|rw, $2 = device, $3 = mount point; ntfs3 first, ntfs-3g fallback
  if [ "$NTFSNO3" != 1 ] && mount -t ntfs3 -o "$1,noatime,iocharset=utf8" "$2" "$3" 2>/run/ntfs.err; then NTFSDRV=ntfs3; return 0; fi
  echo "OMLOADER_STAGE1: ntfs3 $1 mount of $2 failed ($(tail -1 /run/ntfs.err 2>/dev/null)): fallback ntfs-3g"
  if @ntfs-3g "$2" "$3" -o "$1,noatime" 2>/run/ntfs.err; then NTFSDRV=ntfs-3g; return 0; fi
  return 1
}
hostmnt() { # $1 = fs type, $2 = mount options (ro|rw), $3 = device; mounted on $HOST
  if [ "$1" = ntfs ]; then ntfs_mnt "$2" "$3" $HOST; else mount -t "$1" -o "$2" "$3" $HOST 2>/dev/null; fi
}
want_rw() { # $1 = device: is it the loader's data partition (omloader.data=, else VTOYDATA, else the partition holding the ISO)? then rw
  local da v; da=$(arg omloader.data)
  if [ -n "$da" ]; then [ "$(resolve_dev "$da")" = "$1" ]; return; fi
  v=$(blkid -L VTOYDATA 2>/dev/null)
  [ -z "$v" ] || [ "$v" = "$1" ] || [ "$(blkid -o value -s LABEL "$1" 2>/dev/null)" = OMLOADER ]
}
vj_get() { # $1 = key of ventoy/ventoy.json (no jq: tolerant of CRLF/BOM/spacing; empty when absent/malformed). Absolute, no ".."
  local v; v=$(tr -d '\r\357\273\277' < $HOST/ventoy/ventoy.json 2>/dev/null | tr '\n' ' ' | grep -o "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | head -1 | sed 's/^[^:]*:[[:space:]]*"//; s/"$//')
  case "$v" in *..*|"") return 0;; /*) echo "$v";; *) echo "/$v";; esac
}
# partition order: Ventoy-looking first (label Ventoy/VTOYDATA, or a /ventoy dir), then the rest in /proc/partitions order
part_order() {
  local n t l a= b=; P=/run/medium-probe; mkdir -p $P
  for n in $(awk 'NR>2{print $4}' /proc/partitions); do
    case "$n" in loop*|ram*|dm-*) continue;; esac
    [ -b "/dev/$n" ] || continue
    t=$(blkid -o value -s TYPE "/dev/$n" 2>/dev/null); l=$(blkid -o value -s LABEL "/dev/$n" 2>/dev/null)
    case "$t" in exfat|vfat|ext2|ext3|ext4|xfs|ntfs) ;; *) continue;; esac
    case "$l" in Ventoy|VTOYDATA) a="$a $n"; continue;; esac
    if probe_mnt "$t" "/dev/$n" && { [ -d $P/ventoy ] || [ -f $P/ventoy/ventoy.json ]; }; then a="$a $n"; else b="$b $n"; fi
    umount $P 2>/dev/null
  done
  echo $a $b
}
probe_mnt() { if [ "$1" = ntfs ]; then ntfs_mnt ro "$2" $P >/dev/null; else mount -t "$1" -o ro "$2" $P 2>/dev/null; fi; }
# after a hit: list other partitions that also hold an omloader ISO (just for the log)
skipped_list() { # $@ = remaining partitions
  local n t out= c; P=/run/medium-probe
  for n in "$@"; do
    t=$(blkid -o value -s TYPE "/dev/$n" 2>/dev/null)
    case "$t" in exfat|vfat|ext2|ext3|ext4|xfs|ntfs) ;; *) continue;; esac
    probe_mnt "$t" "/dev/$n" || continue
    for c in $P/omloader.iso $P/omloader/omloader*.iso $P/ISO/omloader.iso; do [ -f "$c" ] && out="$out /dev/$n:${c#$P}"; done
    umount $P 2>/dev/null
  done
  [ -n "$out" ] && echo "OMLOADER_STAGE1: iso: skipped other candidates:$out"
}
scan_dev() { # $1 = partition/disk device. 0 = ISO found (host fs stays mounted on $HOST, ISO on /run/medium)
  d=$1; t=$(blkid -o value -s TYPE "$d" 2>/dev/null); HRW=0
  case "$t" in exfat|vfat|ext2|ext3|ext4|xfs|ntfs) ft=$t;; *) return 1;; esac
  hostmnt "$ft" ro "$d" || return 1
  f=; STEP=
  if [ -n "$ISOFILE" ]; then iso_try "$HOST$ISOFILE" 1 && { f=$ISOFILE; STEP=pinned; }
  else
    # Ventoy conventions: ventoy/ventoy.json control VTOY_DEFAULT_SEARCH_ROOT (searched recursively by Ventoy) and VTOY_DEFAULT_IMAGE
    R=$(vj_get VTOY_DEFAULT_SEARCH_ROOT); R=${R%/}
    if [ -n "$R" ]; then for c in "$HOST$R"/*.iso "$HOST$R"/*/*.iso "$HOST$R"/*/*/*.iso; do iso_try "$c" && { f=${c#$HOST}; STEP=ventoy-search-root; break; }; done; fi
    if [ -z "$f" ]; then R=$(vj_get VTOY_DEFAULT_IMAGE); [ -n "$R" ] && iso_try "$HOST$R" && { f=$R; STEP=ventoy-default-image; }; fi
    if [ -z "$f" ]; then for c in "$HOST"/omloader/omloader.iso "$HOST"/omloader/omloader-*.iso "$HOST"/omloader.iso "$HOST"/ISO/omloader.iso; do iso_try "$c" 1 && { f=${c#$HOST}; STEP=omloader-dir; break; }; done; fi
    if [ -z "$f" ]; then for c in "$HOST"/*.iso "$HOST"/*/*.iso "$HOST"/*/*/*.iso; do iso_try "$c" && { f=${c#$HOST}; STEP=scan; break; }; done; fi
  fi
  if [ -n "$f" ]; then
    ISOPATH=$f
    # the data partition is mounted rw by omloader-mounts later: switch this (shared) mount to rw now so both agree
    if want_rw "$d"; then
      if [ "$ft" = ntfs ]; then
        if [ "$NTFSDRV" = ntfs3 ] && mount -o remount,rw $HOST 2>/run/ntfs.err; then HRW=1
        else # ntfs3 refused rw (dirty/hibernated) or the volume is on ntfs-3g (FUSE cannot remount): release the ISO, mount again rw with ntfs-3g
          [ "$NTFSDRV" = ntfs3 ] && echo "OMLOADER_STAGE1: $d ntfs3 rw remount failed ($(tail -1 /run/ntfs.err)): trying ntfs-3g rw"
          umount /run/medium 2>/dev/null; losetup -d "$ISOLOOP" 2>/dev/null; umount $HOST 2>/dev/null
          k=0; while [ $k -lt 15 ]; do @ntfs-3g "$d" $HOST -o rw,noatime 2>/run/ntfs.err && { HRW=1; NTFSDRV=ntfs-3g; break; }; k=$((k+1)); sleep 0.2; done
          if [ $HRW = 0 ]; then echo "OMLOADER_STAGE1: $d (ntfs) not mountable read-write ($(tail -1 /run/ntfs.err)): read-only"; hostmnt ntfs ro "$d" || return 1; fi
          iso_try "$HOST$f" 1 || { umount $HOST 2>/dev/null; return 1; }
        fi
      else mount -o remount,rw $HOST 2>/dev/null && HRW=1; fi
    fi
    cat > /run/omloader/medium.env <<ENV
MEDIUM_VIA=iso-scan
MEDIUM_STEP=$STEP
MEDIUM_HOST_DEV=$d
MEDIUM_HOST_FS=$ft
MEDIUM_HOST_MNT=$HOST
MEDIUM_HOST_RW=$HRW
MEDIUM_HOST_DRV=${NTFSDRV:-$ft}
MEDIUM_ISO=$f
MEDIUM_ISO_LOOP=$ISOLOOP
ENV
    FOUND=$d; HOW="iso-scan: dev=$d fs=$ft file=$f"
    echo "OMLOADER_STAGE1: iso: $d ($ft, label $(blkid -o value -s LABEL "$d" 2>/dev/null)) $f via $STEP"; return 0
  fi
  umount $HOST 2>/dev/null; SCANNED="$SCANNED$d "; return 1
}
i=0
while [ $i -lt 40 ] && [ -z "$FOUND" ]; do
  OV=$(arg omloader.live)
  [ -n "$OV" ] && [ -b "$OV" ] && try_dev "$OV" && { FOUND=$OV; HOW="omloader.live="; }
  if [ -z "$FOUND" ]; then   # (a) volume label
    L=$(blkid -L OMLOADER_LIVE 2>/dev/null)
    [ -n "$L" ] && try_dev "$L" && { FOUND=$L; HOW="label OMLOADER_LIVE"; }
  fi
  if [ -z "$FOUND" ]; then   # (b) scan every block device (ISO written to a USB stick / re-labelled / Ventoy dm device)
    for d in /dev/sr* /dev/mapper/* /dev/sd* /dev/vd* /dev/nvme*n* /dev/mmcblk*; do
      [ -b "$d" ] || continue
      try_dev "$d" && { FOUND=$d; HOW="device scan"; break; }
    done
  fi
  if [ -z "$FOUND" ] && [ $i -ge 2 ]; then   # (c) ISO file on a partition
    if [ -n "$ISODEV" ]; then
      d=$(resolve_dev "$ISODEV"); [ -b "$d" ] && scan_dev "$d"
    else
      ORDER=$(part_order)
      for n in $ORDER; do
        case "$SCANNED" in *" /dev/$n "*) continue;; esac
        if scan_dev "/dev/$n"; then
          REST=; seen=; for m in $ORDER; do [ "$seen" = 1 ] && REST="$REST $m"; [ "$m" = "$n" ] && seen=1; done
          [ -n "$REST" ] && skipped_list $REST; break
        fi
      done
    fi
  fi
  [ -n "$FOUND" ] || { sleep 0.5; i=$((i+1)); }
done
if [ -z "$FOUND" ]; then   # diagnostics: one more, traced, pass over every partition
  echo "OMLOADER_STAGE1: live medium not found; partitions:"; cat /proc/partitions; blkid
  SCANNED=" "; set -x
  for n in $(awk 'NR>2{print $4}' /proc/partitions); do
    case "$n" in loop*|ram*|dm-*) continue;; esac
    [ -b "/dev/$n" ] && scan_dev "/dev/$n" && break
  done
  set +x
fi
[ -n "$FOUND" ] || die "live medium (label OMLOADER_LIVE / live/live.squashfs) not found"
echo "OMLOADER_STAGE1: live medium $FOUND ($HOW)"
mount -t squashfs -o loop,ro /run/medium/live/live.squashfs /run/live || die "cannot mount live.squashfs"
mount -t squashfs -o loop,ro /run/medium/live/omloader.squashfs /run/extra || die "cannot mount omloader.squashfs"
mount -t tmpfs -o mode=755 tmpfs /run/rw
mkdir -p /run/rw/upper /run/rw/work
mount -t overlay overlay -o lowerdir=/run/extra:/run/live,upperdir=/run/rw/upper,workdir=/run/rw/work /newroot || die "overlay mount failed"
mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/run
mount --move /dev /newroot/dev && mount --move /proc /newroot/proc && mount --move /sys /newroot/sys && mount --move /run /newroot/run \
  || echo "OMLOADER_STAGE1: warning: mount --move failed"
echo "OMLOADER_STAGE1: switch_root into the live system"
exec switch_root /newroot /sbin/init
