# Two targets from one package set (shared layer cache):
#   live    - the Debian bookworm live userspace; exported (podman export) and squashed to live.squashfs
#   builder - live + ISO tooling (grub, xorriso, ...); runs build/mk-iso-inner.sh (stage-1 initramfs + ISO)
# The live base is always the latest packages of one Debian stable release; change DEBIAN_RELEASE to move to the next one.
ARG DEBIAN_RELEASE=bookworm
FROM debian:${DEBIAN_RELEASE} AS live
ARG DEBIAN_RELEASE
ARG DEBIAN_MIRROR=http://deb.debian.org/debian
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i "s#http://deb.debian.org/debian#$DEBIAN_MIRROR#g; s#^Components: main\$#Components: main non-free-firmware#" /etc/apt/sources.list.d/debian.sources
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd systemd-sysv systemd-resolved udev dbus kmod \
      util-linux e2fsprogs exfatprogs ntfs-3g xfsprogs squashfs-tools lvm2 dmsetup kpartx kexec-tools qemu-utils xz-utils \
      parted gdisk fdisk cryptsetup \
      iproute2 iputils-ping ca-certificates curl iwd wireless-regdb \
      linux-image-amd64 firmware-linux-free firmware-misc-nonfree firmware-realtek firmware-iwlwifi \
      less nano vim-tiny busybox-static procps pciutils usbutils \
 && rm -f /boot/initrd.img-* \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /var/log/* /usr/share/man /usr/share/info /usr/share/lintian /usr/share/locale \
 && find /usr/share/doc -type f ! -name copyright -delete \
 && find /usr/share/doc -type d -empty -delete
# console fonts for tty1/VNC/screen (docs/tui.md "Console font"): kbd (setfont, kbd_mode) + a Terminus subset taken from
# console-setup-linux (extracted without its keyboard-configuration/xkb dependencies; Terminus is SIL OFL 1.1). kbd +2.0 MB installed (~0.8 MB compressed), fonts 80 KB.
RUN apt-get update && apt-get install -y --no-install-recommends kbd \
 && cd /tmp && apt-get download console-setup-linux \
 && dpkg-deb --fsys-tarfile console-setup-linux_*_all.deb | tar -x -C / \
      ./usr/share/consolefonts/Uni3-TerminusBold16.psf.gz ./usr/share/consolefonts/Uni3-TerminusBold20x10.psf.gz \
      ./usr/share/consolefonts/Uni3-TerminusBold24x12.psf.gz ./usr/share/consolefonts/Uni3-TerminusBold28x14.psf.gz \
      ./usr/share/consolefonts/Uni3-TerminusBold32x16.psf.gz ./usr/share/consolefonts/Uni3-Terminus16.psf.gz \
      ./usr/share/consolefonts/Uni3-Terminus20x10.psf.gz ./usr/share/consolefonts/Uni3-Terminus24x12.psf.gz \
      ./usr/share/consolefonts/Uni3-Terminus28x14.psf.gz ./usr/share/consolefonts/Uni3-Terminus32x16.psf.gz \
 && rm -f /tmp/console-setup-linux_*.deb \
 && mkdir -p /usr/share/doc/console-setup-linux \
 && printf 'Terminus console fonts (Uni3-Terminus*.psf.gz) extracted from the Debian package console-setup-linux (source: console-setup, Terminus font by Dimitar Toshkov Zhekov, SIL Open Font License 1.1). See the package copyright in Debian bookworm.\n' > /usr/share/doc/console-setup-linux/copyright \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /var/log/* /usr/share/man /usr/share/info /usr/share/lintian /usr/share/locale \
 && find /usr/share/doc -type f ! -name copyright -delete && find /usr/share/doc -type d -empty -delete
# base description for /etc/omloader-release and packages.txt (see build/gen-base-info.sh; finished by mk-iso-inner.sh)
COPY gen-base-info.sh /tmp/gen-base-info.sh
RUN BASE_IMAGE=debian:$DEBIAN_RELEASE DEBIAN_MIRROR=$DEBIAN_MIRROR sh /tmp/gen-base-info.sh && rm -f /tmp/gen-base-info.sh

FROM live AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
      grub-efi-amd64-bin grub-common xorriso mtools dosfstools cpio xz-utils \
 && rm -rf /var/lib/apt/lists/*
