[Unit]
Description=omloader autoboot (omloader.image= / hook / selftest), otherwise the shell
After=omloader-mounts.service local-fs.target
Requires=omloader-mounts.service
Before=getty.target serial-getty@ttyS0.service getty@tty1.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=DM_DISABLE_UDEV=1
ExecStart=/usr/local/lib/omloader/autoboot.sh
StandardInput=null
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TimeoutStartSec=infinity
KillMode=process

[Install]
WantedBy=multi-user.target
