{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "path": {
              "type": "string",
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            }
          }
        },
        "snapshots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            },
            "fs_required": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ext4",
                  "btrfs",
                  "xfs"
                ]
              }
            },
            "fallback": {
              "type": "string",
              "enum": [
                "tmpfs",
                "none"
              ]
            },
            "store_file": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "auto_create": {
                  "type": "boolean"
                },
                "path": {
                  "type": "string",
                  "not": {
                    "pattern": "(^|/)\\.\\.(/|$)"
                  }
                },
                "glob": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "not": {
                      "pattern": "(^|/)\\.\\.(/|$)"
                    }
                  }
                },
                "host_match": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "maxLength": 16
                    },
                    "uuid": {
                      "type": "string"
                    }
                  }
                },
                "size": {
                  "type": "string"
                },
                "prealloc": {
                  "type": "string",
                  "enum": [
                    "auto",
                    "yes",
                    "no"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_chain_depth": {
          "type": "integer",
          "minimum": 1
        },
        "persistent": {
          "type": "boolean"
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keep_last": {
              "type": "integer",
              "minimum": 1
            },
            "min_free_percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "keep_tagged": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_checksum": {
          "type": "string",
          "enum": [
            "sha256",
            "skip"
          ]
        }
      }
    },
    "boot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": {
          "type": "integer",
          "minimum": 0
        },
        "default_snapshot": {
          "type": "string"
        },
        "kernel_cmdline_extra": {
          "type": "string"
        },
        "default_image": {
          "type": "string"
        },
        "vm_fix_esp_fstab": {
          "type": "boolean"
        },
        "ui": {
          "type": "string",
          "enum": [
            "tui",
            "shell"
          ]
        },
        "remember_last": {
          "type": "boolean"
        },
        "extra_cmdline_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_backend": {
          "type": "string",
          "enum": [
            "dir",
            "ext4-file",
            "partition",
            "disk",
            "network"
          ]
        },
        "default_vm_backend": {
          "type": "string",
          "enum": [
            "dir",
            "ext4-file",
            "partition",
            "disk",
            "network"
          ]
        },
        "default_location": {
          "type": "string",
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        },
        "auto_home_volume": {
          "type": "boolean"
        },
        "fallback_if_missing": {
          "type": "string",
          "enum": [
            "system-layer",
            "fail",
            "tmpfs"
          ]
        }
      }
    },
    "devices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "isolate",
            "passthrough",
            "hide"
          ]
        },
        "windows_ntfs": {
          "type": "string",
          "enum": [
            "ro_or_hide",
            "ro",
            "hide",
            "rw"
          ]
        },
        "hibernated_fs": {
          "type": "string",
          "enum": [
            "refuse",
            "ro",
            "ignore"
          ]
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "proxy": {
          "type": "string"
        },
        "no_proxy": {
          "type": "string"
        },
        "extra_ca": {
          "type": "string"
        },
        "dns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mirror_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "fallback",
            "fastest",
            "mirror-only"
          ]
        },
        "health_check": {
          "type": "boolean"
        },
        "cache_ttl_hours": {
          "type": "integer",
          "minimum": 0
        },
        "region_preset": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "simplestreams",
              "oci-registry",
              "http",
              "local"
            ]
          },
          "url": {
            "type": "string"
          },
          "mirrors": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https?://"
            }
          },
          "proxy": {
            "type": "string"
          },
          "rewrite": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                }
              }
            }
          },
          "title": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "mirror": {
            "type": "string",
            "description": "official | auto | a server id"
          },
          "servers": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9][a-z0-9_.-]*$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "description": "base URL (oci-registry: host or https://host)"
                },
                "path": {
                  "type": "string",
                  "description": "optional path appended to url"
                },
                "region": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "rewrite": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "from"
                    ],
                    "properties": {
                      "from": {
                        "type": "string"
                      },
                      "to": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "type",
          "url"
        ]
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        },
        "max_size_gb": {
          "type": "integer",
          "minimum": 0
        },
        "offline": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ]
        }
      }
    },
    "guest_defaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "accounts + console autologin for every image type (public default password; see docs/INSTALL.md)",
      "properties": {
        "hostname": {"type": "string"},
        "autologin": {
          "type": "boolean"
        },
        "autologin_user": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
        },
        "root_password": {
          "type": "string"
        },
        "root_password_hash": {
          "type": "string"
        },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
              },
              "password_hash": {
                "type": "string"
              },
              "password": {
                "type": "string"
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "shell": {
                "type": "string",
                "pattern": "^/"
              },
              "sudo": {
                "type": "boolean"
              },
              "ssh_authorized_keys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "experimental": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oci_images": {
          "type": "boolean",
          "default": true,
          "description": "EXPERIMENTAL Docker/OCI image support (import, pull docker:, boot). On by default; set false (or OML_EXPERIMENTAL=off / omloader.experimental=off) to disable."
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_online": {
          "type": "boolean"
        },
        "allowed_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "default_source": {
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "omloader.yaml"
}
